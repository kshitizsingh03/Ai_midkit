# API Credentials for CRM Backend
GROQ_API_KEY=gsk_your_groq_api_key_here

# Database Configuration (Defaults to SQLite in-memory/file if left blank)
# To use PostgreSQL: postgresql://username:password@localhost:5432/mediket
# To use SQLite: sqlite:///./mediket.db
DATABASE_URL=sqlite:///./mediket.db

# Frontend Configurations
VITE_API_URL=http://localhost:8000
